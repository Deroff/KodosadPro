<Window x:Class="KodosadStudio.ProjectPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · библиотека" Width="620" Height="650" MinWidth="540" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#0B0F12" Foreground="#F2F5F4">
    <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#31D6A5"/><Setter Property="Foreground" Value="#09110F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/></Style></Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="PROJECT VAULT / LOCAL SQL" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/><TextBlock Text="Библиотека проектов" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Автосохранённые черновики вашей учётной записи" Foreground="#91A1A7" FontSize="12"/></StackPanel>
        <ListBox x:Name="ProjectsList" Grid.Row="1" Background="#10171B" Foreground="#F2F5F4" BorderBrush="#273238" BorderThickness="1" Padding="5" SelectionMode="Single">
            <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#273238" BorderThickness="0,0,0,1" Padding="12,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Algorithm}" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdatedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#91A1A7" FontSize="10" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#91A1A7" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ОТМЕНА" Background="#253238" Foreground="#DCE5E9" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="ОТКРЫТЬ В РЕДАКТОРЕ  →" Click="Open_Click"/></StackPanel></Grid>
    </Grid>
</Window>
