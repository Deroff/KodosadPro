<Window x:Class="KodosadStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кодосад Studio — анализ сжатия" Width="1500" Height="920" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#101418" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#101418"/><SolidColorBrush x:Key="Panel" Color="#171D22"/><SolidColorBrush x:Key="Panel2" Color="#20282E"/><SolidColorBrush x:Key="Line" Color="#334047"/><SolidColorBrush x:Key="Blue" Color="#2878FF"/><SolidColorBrush x:Key="Green" Color="#15B77E"/><SolidColorBrush x:Key="Red" Color="#F0444A"/><SolidColorBrush x:Key="Text" Color="#F7F9FA"/><SolidColorBrush x:Key="Muted" Color="#93A1A9"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Command" TargetType="Button"><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2,12,2,12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Rail" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Blue}" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#20282E"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#11171B"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Green}"/><Setter Property="Padding" Value="12"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="TerminalShell" Background="#0C1216" BorderBrush="#334047" BorderThickness="1,1,1,2" CornerRadius="0,9,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/><ColumnDefinition Width="37"/></Grid.ColumnDefinitions>
                            <Border Background="#102A24" BorderBrush="{StaticResource Green}" BorderThickness="0,0,1,0"><TextBlock Text="λ" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
                            <Grid Grid.Column="2"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource Blue}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Height="2" Background="{StaticResource Blue}" VerticalAlignment="Bottom" Margin="5,0"/></Grid>
                        </Grid>
                    </Border>
                    <ToggleButton Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"><Border Background="#0C1216" BorderBrush="{StaticResource Blue}" BorderThickness="1,0,1,1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TerminalShell" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DCE5E9"/><Setter Property="Padding" Value="11,8"/><Setter Property="FontFamily" Value="Cascadia Mono"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Node" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}"><Grid><TextBlock x:Name="Prompt" Text=">" Foreground="#51616A"/><ContentPresenter Margin="18,0,0,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Node" Property="Background" Value="#16232A"/><Setter TargetName="Node" Property="BorderBrush" Value="{StaticResource Green}"/><Setter TargetName="Prompt" Property="Foreground" Value="{StaticResource Green}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Node" Property="Background" Value="#14213A"/><Setter TargetName="Node" Property="BorderBrush" Value="{StaticResource Blue}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="11"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#24313A"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#20282E"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9,8"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#0C1013"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="{StaticResource Green}" CornerRadius="3,11,3,11"><TextBlock Text="KS" Foreground="#101418" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="КОДОСАД STUDIO" FontSize="17" FontWeight="Bold"/><TextBlock Text="COMPRESSION ANALYSIS WORKBENCH" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="StageLabel" Text="ЭТАП 2 / 5" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="10" VerticalAlignment="Center" Margin="0,0,13,0"/><StackPanel Orientation="Horizontal"><Border x:Name="StageDot1" Width="28" Height="4" Background="{StaticResource Green}" Margin="0,0,5,0"/><Border x:Name="StageDot2" Width="28" Height="4" Background="{StaticResource Green}" Margin="0,0,5,0"/><Border x:Name="StageDot3" Width="28" Height="4" Background="#263138" Margin="0,0,5,0"/><Border x:Name="StageDot4" Width="28" Height="4" Background="#263138" Margin="0,0,5,0"/><Border x:Name="StageDot5" Width="28" Height="4" Background="#263138"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⇥ ОТКРЫТЬ ФАЙЛ" Click="OpenFile_Click" Style="{StaticResource Command}" Background="#20282E" Margin="0,0,8,0"/><Button Content="АРХИВ · KHF" Click="SaveHuffmanArchive_Click" Style="{StaticResource Command}" Background="{StaticResource Green}" Foreground="#101418" Margin="0,0,8,0"/><Button Content="БИБЛИОТЕКА БД" Click="Projects_Click" Style="{StaticResource Command}" Background="#20282E" Margin="0,0,8,0"/><Button Content="СЕАНС .KODO" Click="SaveProject_Click" Style="{StaticResource Command}" Background="#20282E" Margin="0,0,8,0"/><Button Content="ЭКСПОРТ TXT ⇤" Click="Export_Click" Style="{StaticResource Command}" Margin="0,0,8,0"/><Button x:Name="ProfileButton" Content="ПРОФИЛЬ" Click="Profile_Click" Style="{StaticResource Command}" Background="#102A24" Foreground="{StaticResource Green}"/></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="470"/></Grid.ColumnDefinitions>
            <Border Background="#0C1013" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="18,20"><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,0,10"/><Button Content="01  Кодирование" Click="FocusSource_Click" Style="{StaticResource Rail}" Foreground="White" Background="#171D22"/><Button Content="02  Сравнение методов" Click="CompareNav_Click" Style="{StaticResource Rail}"/><Button Content="03  Анализ файла" Click="FileNav_Click" Style="{StaticResource Rail}"/><Button Content="04  Архив расчётов" Click="History_Click" Style="{StaticResource Rail}"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="18,0,18,18"><Border Background="#0F211D" BorderBrush="{StaticResource Green}" BorderThickness="2,0,0,0" Padding="10,8" Margin="0,0,0,14"><StackPanel><TextBlock Text="FILE GATE / TXT ↔ CODE" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono" FontSize="9" FontWeight="Bold"/><TextBlock Text="Текст можно загрузить, закодировать и выгрузить вместе с таблицей кодов." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="ТЕКУЩАЯ СЕССИЯ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="SessionText" Text="Новый проект" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock x:Name="SessionInfo" Text="изменений нет" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
            </Grid></Border>
            <Grid Grid.Column="1" Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="52"/><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="165"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ВХОДНЫЕ ДАННЫЕ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="Редактор источника" FontSize="24" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="АЛГОРИТМ" Foreground="{StaticResource Muted}" FontSize="9"/><ComboBox x:Name="AlgorithmBox" SelectedIndex="0"><ComboBoxItem Content="Хаффман"/><ComboBoxItem Content="Шеннон–Фано"/><ComboBoxItem Content="RLE"/></ComboBox></StackPanel></Grid>
                <TextBox x:Name="SourceBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="15" Text="Информационная теория помогает измерять неопределённость данных и строить эффективные коды без потерь."/>
                <Grid Grid.Row="2" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Content="ВЫПОЛНИТЬ АНАЛИЗ" Click="Run_Click" Style="{StaticResource Command}"/><Button Content="СРАВНИТЬ ВСЕ" Click="Compare_Click" Style="{StaticResource Command}" Background="{StaticResource Green}" Foreground="#101418" Margin="8,0,0,0"/><Button Content="ДЕКОДИРОВАТЬ" Click="Decode_Click" Style="{StaticResource Command}" Background="#20282E" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="ValidationText" Foreground="{StaticResource Red}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <Border Grid.Row="3" Background="#0C1013" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,8,0,0" Padding="12,6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="01" Foreground="{StaticResource Blue}" FontFamily="Cascadia Mono" FontWeight="Bold"/><TextBlock Text="  ИСТОЧНИК" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="   →   " Foreground="#51616A"/><TextBlock Text="02" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono" FontWeight="Bold"/><TextBlock Text="  МОДЕЛЬ ЧАСТОТ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="   →   " Foreground="#51616A"/><TextBlock Text="03" Foreground="{StaticResource Blue}" FontFamily="Cascadia Mono" FontWeight="Bold"/><TextBlock Text="  КОДОВОЕ ДЕРЕВО" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="PIPELINE / LOSSLESS" Foreground="#60717A" FontFamily="Cascadia Mono" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="4" Margin="0,13,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Blue}" BorderThickness="0,3,0,0" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="ENTROPY / H(X)" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="EntropyText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="бит/символ" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Green}" BorderThickness="0,3,0,0" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="AVG CODE / L" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="AverageText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="бит/символ" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Blue}" BorderThickness="0,3,0,0" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="RATIO / K" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="RatioText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="от UTF-8" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
                    <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Green}" BorderThickness="0,3,0,0" Padding="13"><StackPanel><TextBlock Text="REDUNDANCY / R" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="RedundancyText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="бит/символ" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
                </Grid>
                <TextBox x:Name="ResultBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="13"/>
                <DataGrid x:Name="ComparisonGrid" Grid.Row="6" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="White" BorderBrush="{StaticResource Line}" RowBackground="#171D22" AlternatingRowBackground="#20282E" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Метод" Binding="{Binding Algorithm}" Width="*"/><DataGridTextColumn Header="Бит" Binding="{Binding Bits}" Width="90"/><DataGridTextColumn Header="Коэффициент" Binding="{Binding Ratio}" Width="120"/><DataGridTextColumn Header="Средняя длина" Binding="{Binding Average}" Width="120"/></DataGrid.Columns></DataGrid>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="ИНСПЕКТОР АЛГОРИТМА" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="InspectorTitle" Text="Хаффман / дерево" FontSize="20" FontWeight="SemiBold"/></StackPanel><Border HorizontalAlignment="Right" Background="#0F2D25" BorderBrush="{StaticResource Green}" BorderThickness="1" Padding="10,5"><TextBlock x:Name="StateText" Text="READY" Foreground="{StaticResource Green}" FontFamily="Cascadia Mono"/></Border></Grid>
                <TabControl Grid.Row="1" Margin="0,14,0,0"><TabItem Header="ДЕРЕВО"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions><Border Background="#0C1216" BorderBrush="{StaticResource Line}" BorderThickness="1"><Grid ClipToBounds="True"><Canvas x:Name="TreeCanvas" SizeChanged="TreeCanvas_SizeChanged" MouseWheel="TreeCanvas_MouseWheel" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><ScaleTransform x:Name="TreeScale" ScaleX="1" ScaleY="1"/></Canvas.RenderTransform></Canvas><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"><Button Content="−" Click="TreeZoomOut_Click" Style="{StaticResource Command}" Background="#20282E" Padding="10,5" Margin="0,0,4,0"/><Button Content="100%" Click="TreeReset_Click" Style="{StaticResource Command}" Background="#20282E" Padding="10,5" Margin="0,0,4,0"/><Button Content="+" Click="TreeZoomIn_Click" Style="{StaticResource Command}" Background="#20282E" Padding="10,5"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="#11171B" Padding="12"><TextBlock x:Name="TreeInfo" Text="Выполните анализ для построения дерева." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Border></Grid></TabItem>
                    <TabItem Header="КОДЫ"><DataGrid x:Name="CodesGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#11171B" Foreground="White" BorderThickness="0" RowBackground="#11171B" AlternatingRowBackground="#171D22"><DataGrid.Columns><DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="*"/><DataGridTextColumn Header="Частота" Binding="{Binding Frequency}" Width="80"/><DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="ШАГИ"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#0C1216" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="ТЕКУЩАЯ ОПЕРАЦИЯ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="OperationTitleText" Text="Частотная модель готова" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock x:Name="OperationDescriptionText" Text="Переходите по шагам построения дерева." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border><ListBox x:Name="StepsList" Grid.Row="1" Background="#11171B" Foreground="White" BorderThickness="0"/><Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="← НАЗАД" Click="StepBack_Click" Style="{StaticResource Command}" Background="#20282E" Margin="0,0,4,0"/><Button Grid.Column="1" Content="СЛЕД. ШАГ" Click="StepNext_Click" Style="{StaticResource Command}" Background="#20282E" Margin="4,0"/><Button x:Name="AutoStepButton" Grid.Column="2" Content="АВТО" Click="StepAuto_Click" Style="{StaticResource Command}" Background="{StaticResource Green}" Foreground="#101418" Margin="4,0,0,0"/></Grid></Grid></TabItem>
                    <TabItem Header="ИСТОРИЯ"><ListBox x:Name="HistoryList" Background="#11171B" Foreground="White" BorderThickness="0"/></TabItem></TabControl>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#0C1013" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ЧАСТОТНЫЙ СПЕКТР" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="Размер маркера отражает вес символа" Foreground="#60717A" FontSize="9" Margin="0,4,0,0"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0"><StackPanel x:Name="FrequencyStripPanel" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer><TextBlock x:Name="FooterText" Grid.Column="2" Text="SQL SERVER · автосохранение включено" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border>
    </Grid>
</Window>
