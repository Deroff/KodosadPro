<Window x:Class="KodosadStudio.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · доступ" Width="520" Height="700" MinWidth="480" MinHeight="660"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#0B0F12" Foreground="#F2F5F4">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#0B0F12"/><SolidColorBrush x:Key="Panel" Color="#141B1F"/>
        <SolidColorBrush x:Key="Line" Color="#273238"/><SolidColorBrush x:Key="Mint" Color="#31D6A5"/>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,11"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#31D6A5"/><Setter Property="Margin" Value="0,6,0,13"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,6,0,13"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#31D6A5"/><Setter Property="Foreground" Value="#09110F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9BAAAE"/><Setter Property="Padding" Value="15,10"/><Setter Property="Background" Value="#141B1F"/><Setter Property="BorderBrush" Value="#273238"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="2,8,2,24"><StackPanel><TextBlock Text="KODOSAD / SECURE WORKSPACE" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/><TextBlock Text="Рабочее пространство" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="Алгоритмы сжатия · персональные проекты" Foreground="#91A1A7" FontSize="12"/></StackPanel><Border Width="56" Height="56" HorizontalAlignment="Right" Background="#10261F" BorderBrush="#31D6A5" BorderThickness="1"><TextBlock Text="K/" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
        <Border Grid.Row="1" Background="#141B1F" BorderBrush="#273238" BorderThickness="1" Padding="20">
            <TabControl x:Name="ModeTabs" Background="#141B1F" BorderThickness="0">
                <TabItem Header="ВХОД"><StackPanel Margin="4,20,4,4"><TextBlock Text="Продолжить работу" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Введите почту аккаунта и пароль." Foreground="#91A1A7" Margin="0,6,0,18"/><TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА" Foreground="#91A1A7" FontSize="10"/><TextBox x:Name="LoginEmailBox"/><TextBlock Text="ПАРОЛЬ" Foreground="#91A1A7" FontSize="10"/><PasswordBox x:Name="LoginPasswordBox"/><TextBlock x:Name="LoginMessage" Foreground="#FF7580" TextWrapping="Wrap" MinHeight="42" Margin="0,0,0,12"/><Button Content="ВОЙТИ В KODOSAD  →" Click="Login_Click"/><Button Content="ЗАБЫЛИ ПАРОЛЬ? ВОССТАНОВИТЬ  →" Click="ResetPassword_Click" Background="#26373B" Foreground="#DCE9E7" Margin="0,10,0,0" Padding="12,9"/></StackPanel></TabItem>
                <TabItem Header="РЕГИСТРАЦИЯ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,18,4,4"><TextBlock Text="Создать профиль" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Уникальная почта и логин · индивидуальная история анализа." Foreground="#91A1A7" TextWrapping="Wrap" Margin="0,6,0,15"/><TextBlock Text="ИМЯ ДЛЯ ОТОБРАЖЕНИЯ" Foreground="#91A1A7" FontSize="10"/><TextBox x:Name="DisplayNameBox"/><TextBlock Text="ЛОГИН (УНИКАЛЬНЫЙ)" Foreground="#91A1A7" FontSize="10"/><TextBox x:Name="UserNameBox"/><TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА" Foreground="#91A1A7" FontSize="10"/><TextBox x:Name="RegisterEmailBox"/><TextBlock Text="ПАРОЛЬ" Foreground="#91A1A7" FontSize="10"/><PasswordBox x:Name="RegisterPasswordBox"/><TextBlock Text="От 8 символов: верхний и нижний регистр, цифра, знак. Простые пароли блокируются." Foreground="#91A1A7" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/><StackPanel x:Name="VerificationField" Visibility="Collapsed"><TextBlock Text="КОД ИЗ ПИСЬМА" Foreground="#91A1A7" FontSize="10"/><TextBox x:Name="VerificationCodeBox" MaxLength="6"/><TextBlock Text="Код подтверждения действует 10 минут." Foreground="#91A1A7" FontSize="10" Margin="0,0,0,8"/></StackPanel><TextBlock x:Name="RegisterMessage" Foreground="#FF7580" TextWrapping="Wrap" MinHeight="38"/><Button x:Name="RegisterButton" Content="ПОЛУЧИТЬ КОД И СОЗДАТЬ АККАУНТ  ↗" Click="Register_Click"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Border>
        <Grid Grid.Row="2" Margin="0,17,0,0"><Button Content="MAIL API / ПОЧТА" Click="MailSettings_Click" HorizontalAlignment="Left" Padding="10,7" FontSize="10"/><TextBlock x:Name="DatabaseState" Text="SECURE" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Grid>
</Window>
