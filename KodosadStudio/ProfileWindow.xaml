<Window x:Class="KodosadStudio.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · профиль" Width="480" Height="610" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0B0F12" Foreground="#F2F5F4">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#31D6A5"/><Setter Property="Foreground" Value="#09110F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,11"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5F4"/></Style>
    </Window.Resources>
    <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="USER / SECURITY" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/><TextBlock Text="Профиль и безопасность" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="#141B1F" BorderBrush="#273238" BorderThickness="1" Padding="15" Margin="0,20,0,16"><StackPanel><TextBlock Text="АККАУНТ" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/><TextBlock x:Name="DisplayNameText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="EmailText" Foreground="#9BAAAE"/><TextBlock x:Name="UserNameText" Foreground="#9BAAAE" FontFamily="Cascadia Mono" FontSize="11" Margin="0,8,0,0"/><TextBlock x:Name="EmailStatusText" Foreground="#9BAAAE" FontSize="11" Margin="0,12,0,5"/><Button x:Name="VerifyEmailButton" Content="ПОДТВЕРДИТЬ ПОЧТУ  ↗" Click="VerifyEmail_Click" Padding="10,7" FontSize="11" HorizontalAlignment="Left"/></StackPanel></Border>
        <StackPanel Grid.Row="2"><TextBlock Text="СМЕНИТЬ ПАРОЛЬ" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10" Margin="0,0,0,9"/><TextBlock Text="Текущий пароль" Foreground="#9BAAAE" FontSize="11"/><PasswordBox x:Name="CurrentPasswordBox"/><TextBlock Text="Новый пароль" Foreground="#9BAAAE" FontSize="11"/><PasswordBox x:Name="NewPasswordBox"/><TextBlock Text="Нужны буквы верхнего и нижнего регистра, цифра и знак; длина — не менее 8 символов." Foreground="#9BAAAE" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="FeedbackText" Foreground="#31D6A5" TextWrapping="Wrap" Margin="0,15,0,4"/></StackPanel>
        <Button Grid.Row="3" Content="ОБНОВИТЬ ПАРОЛЬ  ↗" Click="ChangePassword_Click"/>
    </Grid>
</Window>
