<Window x:Class="KodosadStudio.EmailVerificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · подтверждение почты" Width="470" Height="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0B0F12" Foreground="#F2F5F4">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#31D6A5"/><Setter Property="Foreground" Value="#09110F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <StackPanel Margin="25">
        <TextBlock Text="EMAIL / VERIFY" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/>
        <TextBlock Text="Подтвердить почту" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,12"/>
        <TextBlock Text="Код придёт только на адрес, уже сохранённый в вашем аккаунте. Для запроса введите текущий пароль." Foreground="#9BAAAE" TextWrapping="Wrap"/>
        <TextBlock x:Name="EmailText" Foreground="#31D6A5" Margin="0,8,0,17"/>
        <TextBlock Text="ТЕКУЩИЙ ПАРОЛЬ" Foreground="#9BAAAE" FontSize="10"/>
        <PasswordBox x:Name="CurrentPasswordBox"/>
        <Button x:Name="RequestButton" Content="ОТПРАВИТЬ КОД  ↗" Click="Request_Click"/>
        <TextBlock Text="КОД ИЗ ПИСЬМА" Foreground="#9BAAAE" FontSize="10" Margin="0,19,0,0"/>
        <TextBox x:Name="CodeBox" MaxLength="6"/>
        <Button x:Name="CompleteButton" Content="ПОДТВЕРДИТЬ ПОЧТУ  ↗" Click="Complete_Click"/>
        <TextBlock x:Name="FeedbackText" Foreground="#31D6A5" TextWrapping="Wrap" MinHeight="40" Margin="0,13,0,0"/>
    </StackPanel>
</Window>
