<Window x:Class="KodosadStudio.PasswordResetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · восстановление" Width="500" Height="680" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0B0F12" Foreground="#F2F5F4">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0E1418"/><Setter Property="Foreground" Value="#F2F5F4"/><Setter Property="BorderBrush" Value="#344149"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#31D6A5"/><Setter Property="Foreground" Value="#09110F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25">
        <TextBlock Text="ACCOUNT / RECOVERY" Foreground="#31D6A5" FontFamily="Cascadia Mono" FontSize="10"/>
        <TextBlock Text="Восстановить пароль" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,13"/>
        <TextBlock Text="Код отправляется только на ранее подтверждённую почту. Для старого аккаунта сначала войдите с прежним паролем и подтвердите почту в профиле." Foreground="#9BAAAE" TextWrapping="Wrap" Margin="0,0,0,17"/>
        <TextBlock Text="ПОЧТА АККАУНТА" Foreground="#9BAAAE" FontSize="10"/>
        <TextBox x:Name="EmailBox" MaxLength="254"/>
        <Button x:Name="RequestButton" Content="ПОЛУЧИТЬ КОД  ↗" Click="Request_Click"/>
        <TextBlock Text="КОД ИЗ ПИСЬМА" Foreground="#9BAAAE" FontSize="10" Margin="0,19,0,0"/>
        <TextBox x:Name="CodeBox" MaxLength="32"/>
        <TextBlock Text="НОВЫЙ ПАРОЛЬ" Foreground="#9BAAAE" FontSize="10"/>
        <PasswordBox x:Name="PasswordBox"/>
        <TextBlock Text="ПОВТОРИТЕ НОВЫЙ ПАРОЛЬ" Foreground="#9BAAAE" FontSize="10"/>
        <PasswordBox x:Name="ConfirmBox"/>
        <TextBlock Text="Не менее 8 символов: заглавная и строчная буквы, цифра и знак. Код действует 10 минут, допускается не более 5 ошибок." Foreground="#9BAAAE" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button x:Name="CompleteButton" Content="УСТАНОВИТЬ НОВЫЙ ПАРОЛЬ  ↗" Click="Complete_Click"/>
        <TextBlock x:Name="FeedbackText" Foreground="#31D6A5" TextWrapping="Wrap" MinHeight="48" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
</Window>
