<Window x:Class="KodosadStudio.AnalysisHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodosad Studio · архив расчётов" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#101418" Foreground="#F7F9FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#334047"/>
        <SolidColorBrush x:Key="Muted" Color="#93A1A9"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F7F9FA"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#20282E"/><Setter Property="Foreground" Value="#E8EFF2"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2,10,2,10">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20282E"/><Setter Property="Foreground" Value="#93A1A9"/>
            <Setter Property="BorderBrush" Value="#334047"/><Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E8EFF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14543F"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#E8EFF2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26342F"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14543F"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="KODOSAD / RUN ARCHIVE" Foreground="#15B77E" FontFamily="Cascadia Mono" FontSize="10"/>
                <TextBlock Text="Архив расчётов" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,2"/>
                <TextBlock x:Name="RunCountText" Text="Персональная история операций сжатия" Foreground="#93A1A9" FontSize="12"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#15B77E" BorderThickness="0,0,3,0" Padding="14,5">
                <TextBlock Text="DPAPI · ТОЛЬКО ЭТОТ ПРОФИЛЬ WINDOWS" Foreground="#15B77E" FontFamily="Cascadia Mono" FontSize="9"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="RunsGrid_SelectionChanged" Background="#171D22" Foreground="#F7F9FA"
                      BorderBrush="#334047" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#273238"
                      RowBackground="#171D22" AlternatingRowBackground="#1D252B" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата / время" Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="120"/>
                    <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="Метод" Binding="{Binding Algorithm}" Width="110"/>
                    <DataGridTextColumn Header="Симв." Binding="{Binding SourceCharacters}" Width="64"/>
                    <DataGridTextColumn Header="Сжато" Binding="{Binding RatioPercent, StringFormat={}{0:0.0}%}" Width="76"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="#0C1216" BorderBrush="#334047" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="ВЫБРАННЫЙ ПРОГОН" Foreground="#15B77E" FontFamily="Cascadia Mono" FontSize="9"/>
                        <TextBlock x:Name="SelectionTitle" Text="Выберите запись слева" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="MetricsText" Foreground="#93A1A9" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="ИСХОДНЫЙ ТЕКСТ · ЗАЩИЩЁННАЯ КОПИЯ" Foreground="#93A1A9" FontFamily="Cascadia Mono" FontSize="9" Margin="0,0,0,6"/>
                        <TextBox x:Name="SourcePreview" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#11171B" Foreground="#E8EFF2"
                                 BorderBrush="#334047" Padding="10" FontFamily="Cascadia Mono" FontSize="11"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,14,0,6">
                        <TextBlock Text="КОДОВЫЙ ПОТОК · ЗАЩИЩЁННАЯ КОПИЯ" Foreground="#93A1A9" FontFamily="Cascadia Mono" FontSize="9"/>
                        <TextBlock x:Name="StatusText" Text="" Foreground="#15B77E" HorizontalAlignment="Right" FontSize="10"/>
                    </Grid>
                    <TextBox x:Name="OutputPreview" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#11171B" Foreground="#15B77E"
                             BorderBrush="#334047" Padding="10" FontFamily="Cascadia Mono" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Архив сохраняет точный исходный текст и результат на момент анализа; новые изменения проекта не переписывают историю." Foreground="#93A1A9" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,330,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="КОПИРОВАТЬ ТЕКСТ" Click="CopySource_Click" Margin="0,0,8,0"/>
                <Button Content="КОПИРОВАТЬ ПОТОК" Click="CopyOutput_Click" Background="#15B77E" Foreground="#101418"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
